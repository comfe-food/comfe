# ---------------------------------------------------------------------------
# Comfe — variáveis de ambiente
# Copia este ficheiro para `.env.local` e preenche os valores.
# NUNCA commites chaves reais.
# ---------------------------------------------------------------------------

# URL pública do site (usada em SEO/Open Graph e nos webhooks)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ---------------------------------------------------------------
# Project URL (pública, vai para o browser)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave "anon" pública (só é segura porque o RLS está ativo)
NEXT_PUBLIC_SUPABASE_ANON_KEY=chave-anon-publica

# Chave "service_role" — SÓ NO SERVIDOR (Route Handlers / Server Actions).
# Nunca comece com NEXT_PUBLIC_ e nunca a uses em código de cliente.
SUPABASE_SERVICE_ROLE_KEY=chave-service-role-secreta

# --- Agregador de pagamentos MB WAY (Ifthenpay) -----------------------------
# Enquanto payment_mode = "manual" no painel, estas chaves podem ficar vazias.
IFTHENPAY_API_KEY=
# Chave secreta usada para validar o webhook do Ifthenpay (Hash/Token)
IFTHENPAY_WEBHOOK_SECRET=
# Referência/entidade MB WAY atribuída à tua conta (modo automático)
IFTHENPAY_MBWAY_ENTITY=

# --- Segurança --------------------------------------------------------------
# Chave usada para assinar ligações internas (ex.: criação de pedidos)
# Gera com: openssl rand -base64 32
COMFE_SECRET_KEY=

# --- Limites anti-abuso -----------------------------------------------------
# Máximo de pedidos por IP dentro da janela de 10 minutos (por omissão: 3)
ORDER_RATE_LIMIT_IP=3
# Máximo de pedidos por telefone dentro da janela de 10 minutos (por omissão: 5)
ORDER_RATE_LIMIT_PHONE=5
